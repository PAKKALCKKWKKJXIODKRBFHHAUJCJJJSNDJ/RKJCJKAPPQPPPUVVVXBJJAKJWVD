local JobHash = 0

for i = 1, #game.JobId do
	JobHash = (JobHash * 31 + string.byte(game.JobId, i)) % 2147483647
end

local function makeSeed(name)
	local hash = JobHash

	for i = 1, #name do
		hash = (hash * 31 + string.byte(name, i)) % 2147483647
	end

	return hash
end

local function getRoll(entity, cycle)
	local seed = makeSeed(entity.Name)

	seed = (seed + cycle * 104729) % 2147483647

	local random = Random.new(seed)

	if entity.OneIn then
		return random:NextInteger(1, entity.OneIn) == 1
	end

	return random:NextNumber(0, 100) <= entity.Chance
end

