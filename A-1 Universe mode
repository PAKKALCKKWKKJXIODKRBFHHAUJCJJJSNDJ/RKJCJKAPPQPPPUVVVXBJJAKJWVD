local function waitForRoomChange(previousRoom)
	while Alive and getRoom() <= previousRoom do
		LatestRoom.Changed:Wait()
	end

	return Alive
end

local function runEntity(entity)
	if not Alive then
		return
	end

	spawnEntity(entity.URL)
end

local function createScheduler(entity)
	if entity.Interval == nil then
		task.spawn(function()
			if Alive then
				runEntity(entity)
			end
		end)

		return
	end

	local interval = entity.Interval

	local firstFire = StartTime + interval

	task.spawn(function()
		local cycle = 1

		while Alive do
			local targetTime = firstFire + ((cycle - 1) * interval)

			while Alive do
				local remaining = targetTime - now()

				if remaining <= 0 then
					break
				end

				task.wait(math.min(remaining, 0.25))
			end

			if not Alive then
				break
			end

			if entity.WaitForRoom then
				local roomBefore = getRoom()

				if getRoom() <= roomBefore then
					local roomChanged = waitForRoomChange(roomBefore)

					if not roomChanged then
						break
					end
				end
			end

			if getRoll(entity, cycle) then
				runEntity(entity)
			end

			cycle += 1

			if now() > targetTime + interval then
				cycle = math.floor((now() - firstFire) / interval) + 1
			end
		end
	end)
end

for _, entity in ipairs(Entities) do
	createScheduler(entity)
end

